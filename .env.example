# Copy to .env and fill in. .env is gitignored and never logged.
# The frontend never sees this key - all model calls happen server-side.
#
# Works with either an OpenAI key or an OpenRouter key (OpenRouter speaks the
# OpenAI API, including structured outputs and embeddings). The default base
# URL below targets OpenRouter; for OpenAI directly, set PYS_OPENAI_BASE_URL=
# (empty) and drop the "openai/" prefix from the model names.
OPENAI_API_KEY=sk-...

# --- optional overrides (defaults shown) ---
# PYS_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# PYS_MODEL_NAME=openai/gpt-4o
# PYS_CLASSIFIER_MODEL_NAME=openai/gpt-4o-mini
# PYS_EMBEDDING_MODEL=openai/text-embedding-3-small
# PYS_LLM_MAX_TOKENS=2048
# PYS_LOG_LEVEL=INFO
# PYS_LOG_FORMAT=json          # json | console
# PYS_CORS_ORIGINS=http://localhost:3000
