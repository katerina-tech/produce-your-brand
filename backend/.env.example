

# --- Tracing (optional) -------------------------------------------------
# Leave empty and the application behaves exactly as it does without them.
# Sign up at cloud.langfuse.com, create a project, copy the key pair.
# Both must be set: a half-configured pair counts as tracing off.
PYS_LANGFUSE_PUBLIC_KEY=
PYS_LANGFUSE_SECRET_KEY=
# EU region by default. Use https://us.cloud.langfuse.com for the US one.
PYS_LANGFUSE_HOST=https://cloud.langfuse.com
PYS_LANGFUSE_ENVIRONMENT=development
