# Copy to .env and fill in. .env is gitignored and never logged.
# The frontend never sees this key - all model calls happen server-side.
OPENAI_API_KEY=sk-...

# --- optional overrides (defaults shown) ---
# PYS_MODEL_NAME=gpt-4o
# PYS_CLASSIFIER_MODEL_NAME=gpt-4o-mini
# PYS_EMBEDDING_MODEL=text-embedding-3-small
# PYS_LOG_LEVEL=INFO
# PYS_LOG_FORMAT=json          # json | console
# PYS_CORS_ORIGINS=http://localhost:3000
